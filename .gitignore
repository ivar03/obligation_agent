# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Node / Next.js
node_modules/
.next/

# Secrets — ignore every .env variant, but keep the committed templates
.env
.env.*
!.env.example
!.env.production.example

# Local SQLite databases (dev/test artifacts, regenerated by seed.py)
*.db

# Agent workspace (local planning/ledger scratch)
.superpowers/

# Agent planning scratch only. Do NOT ignore all of `docs` — docs/operations/ and
# docs/security/ are shipped documentation, and a bare `docs` rule silently keeps
# new files there (e.g. strands_runtime.md) out of every commit.
docs/superpowers/