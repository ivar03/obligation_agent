# ==============================================================================
# Obligation Agent — Production Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
APP_ENV=production
AUTH_MODE=production
DEBUG=false
PROJECT_NAME="Obligation Agent API"
VERSION=0.2.0

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./obligations.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/obligation_db

# Security & Secrets (Must be generated with high entropy >= 32 chars)
JWT_SECRET_KEY=replace_with_high_entropy_jwt_secret_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=replace_with_base64_urlsafe_fernet_key_32_bytes

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_WEBHOOK_PER_MINUTE=300

# Background Worker & Retention
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
DATA_RETENTION_DAYS=90

# Frontend & CORS
FRONTEND_URL=http://localhost:3000

# Provider Integrations (Slack / Gmail / Google Calendar)
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google_calendar/callback
GOOGLE_CALENDAR_WEBHOOK_SECRET=
