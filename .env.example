# ==============================================================================
# Obligation Agent — Comprehensive Configuration Template (.env.example)
# ==============================================================================

# Core Application Settings
APP_ENV=development
AUTH_MODE=mock
DEBUG=true
PROJECT_NAME="Obligation Agent API"
VERSION=0.2.0

# Database Configuration
DATABASE_URL=sqlite+aiosqlite:///./obligations.db
# For PostgreSQL in production:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/obligation_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Security & Secrets (Must be generated with high entropy >= 32 chars in production)
JWT_SECRET_KEY=dev-jwt-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=

# Frontend & CORS
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Rate Limiting & Resource Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
RATE_LIMIT_CSV_IMPORT_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_DECISION_GEN_PER_MINUTE=20
RATE_LIMIT_EXECUTION_DISPATCH_PER_MINUTE=10

# Background Worker & Retention
WORKER_ENABLED=true
WORKER_CONCURRENCY=4
WORKER_DURABLE_QUEUE=true
WORKER_LEASE_TIMEOUT_SECONDS=300
WORKER_MAX_QUEUE_DEPTH=10000
DATA_RETENTION_DAYS=90

# Circuit Breaker & Provider Isolation
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
PROVIDER_TIMEOUT_SECONDS=10

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=text
METRICS_ENABLED=true
METRICS_WINDOW_SIZE=1000

# ------------------------------------------------------------------------------
# Natural-Language AI & Google Gemini Intelligence Configuration
# ------------------------------------------------------------------------------
LLM_ENABLED=true
# Provider options: "mock" (offline development/testing) | "gemini" (direct google-genai SDK)
# | "strands" (Gemini via AWS Strands agent runtime — same model, agentic tool-orchestration layer)
LLM_PROVIDER=mock
# Model name: "gemini-1.5-flash" (recommended), "gemini-1.5-pro"
LLM_MODEL=gemini-1.5-flash
# Google Gemini API Key (Required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# LLM Operational Parameters
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_REQUEST=2048
LLM_MAX_DAILY_REQUESTS=5000
LLM_TIMEOUT_SECONDS=5.0
LLM_TEMPERATURE=0.0
LLM_FALLBACK_TO_DETERMINISTIC=true
# Max tool calls the Strands investigation agent may make per investigation (only used when LLM_PROVIDER=strands)
STRANDS_MAX_TOOL_CALLS=6
# Wall-clock ceiling for one agentic run, including all its tool calls
STRANDS_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------------------
# Development & Demo Environment Seed Settings (Optional)
# ------------------------------------------------------------------------------
DEMO_USER_EMAIL=demo@obligation.local
DEMO_USER_PASSWORD=demo1234
DEMO_WORKSPACE_NAME="Demo Workspace"
DEMO_WORKSPACE_ID=ws-default
DEMO_USER_ID=usr-default

# ------------------------------------------------------------------------------
# Provider Integrations (Slack / Gmail / Google Calendar) - Optional
# ------------------------------------------------------------------------------
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:8000/api/integrations/slack/callback

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google_calendar/callback
GOOGLE_CALENDAR_WEBHOOK_SECRET=

# Jira Cloud Integration (External Work Provider)
JIRA_ENABLED=true
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_WEBHOOK_SECRET=
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=http://localhost:8000/api/integrations/jira/callback

