# =============================================================================
# Obligation Agent — Authoritative Production Environment Template (.env.production)
# =============================================================================

# Application Environment
APP_ENV=production
AUTH_MODE=production
DEBUG=false
PROJECT_NAME="Obligation Agent"
VERSION=0.2.0

# Database (PostgreSQL with asyncpg required in production)
DATABASE_URL=postgresql+asyncpg://obligation_user:YOUR_STRONG_DB_PASSWORD@postgres:5432/obligations_prod
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# CORS & Frontend
FRONTEND_URL=https://app.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Cryptography & Session Security (MUST be >= 32 high-entropy characters)
JWT_SECRET_KEY=generate-at-least-32-chars-high-entropy-random-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=generate-base64-fernet-key-32-bytes-here==

# Background Worker & Durability
WORKER_ENABLED=true
WORKER_CONCURRENCY=8
WORKER_DURABLE_QUEUE=true
WORKER_LEASE_TIMEOUT_SECONDS=300
WORKER_MAX_QUEUE_DEPTH=10000
DATA_RETENTION_DAYS=90

# Circuit Breaker Settings
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT=60
PROVIDER_TIMEOUT_SECONDS=10

# Rate Limiting & Resource Protection
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=15
RATE_LIMIT_WEBHOOK_PER_MINUTE=300
RATE_LIMIT_CSV_IMPORT_PER_MINUTE=10
RATE_LIMIT_SEARCH_PER_MINUTE=30
RATE_LIMIT_DECISION_GEN_PER_MINUTE=20
RATE_LIMIT_EXECUTION_DISPATCH_PER_MINUTE=10

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
METRICS_WINDOW_SIZE=1000

# Disaster Recovery & Backups
BACKUP_ENABLED=true
BACKUP_DIR=/var/lib/app/backups
BACKUP_RETENTION_COUNT=14
BACKUP_VERIFY_ON_CREATE=true

# -----------------------------------------------------------------------------
# Phase 20 / Phase 22 Natural-Language AI & LLM Intelligence Configuration
# -----------------------------------------------------------------------------
LLM_ENABLED=true
# Provider options: "mock" (offline/deterministic) | "gemini" (Google Gemini API)
LLM_PROVIDER=gemini
# Model name: "gemini-1.5-flash" (production fast), "gemini-1.5-pro" (deep reasoning)
LLM_MODEL=gemini-1.5-flash
# Google Gemini API Key (Required for production real LLM calls)
GEMINI_API_KEY=your-production-gemini-api-key-here
# LLM Operational Parameters
LLM_MAX_REQUESTS_PER_MINUTE=60
LLM_MAX_TOKENS_PER_REQUEST=2048
LLM_MAX_DAILY_REQUESTS=5000
LLM_TIMEOUT_SECONDS=5.0
LLM_TEMPERATURE=0.0
LLM_FALLBACK_TO_DETERMINISTIC=true

# Provider Integrations (Optional)
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://api.yourdomain.com/api/integrations/slack/callback

GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
GMAIL_PUBSUB_VERIFICATION_TOKEN=

GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_WEBHOOK_SECRET=

# Jira Cloud Integration (External Work Provider)
JIRA_ENABLED=true
JIRA_SITE_URL=https://your-domain.atlassian.net
JIRA_USER_EMAIL=jira-service-account@yourdomain.com
JIRA_API_TOKEN=your-production-jira-api-token
JIRA_WEBHOOK_SECRET=your-production-jira-webhook-secret-32-chars-entropy
JIRA_CLIENT_ID=
JIRA_CLIENT_SECRET=
JIRA_REDIRECT_URI=https://api.yourdomain.com/api/integrations/jira/callback

