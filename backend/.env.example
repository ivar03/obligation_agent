# Backend Environment Configuration
PROJECT_NAME="Obligation Agent API"
VERSION="0.2.0"
DEBUG=True

# Database Configuration
# Default to SQLite for zero-config local run; for PostgreSQL use: postgresql+asyncpg://postgres:postgres@localhost:5432/obligation_db
DATABASE_URL="sqlite+aiosqlite:///./obligations.db"

# CORS Configuration
FRONTEND_URL="http://localhost:3000"

# LLM Extraction Configuration (DEV_MOCK, OPENAI, GEMINI)
LLM_PROVIDER="DEV_MOCK"
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Phase 8: Slack Integration Configuration
SLACK_ENABLED=false
SLACK_SIGNING_SECRET=""
SLACK_BOT_TOKEN=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
SLACK_REDIRECT_URI="http://localhost:8000/api/integrations/slack/callback"
SLACK_SIGNATURE_TOLERANCE_SECONDS=300

# Phase 9: Gmail Integration Configuration
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REDIRECT_URI="http://localhost:8000/api/integrations/gmail/callback"
GMAIL_PUBSUB_TOPIC=""
GMAIL_PUBSUB_VERIFICATION_TOKEN=""

# Phase 10: Google Calendar Integration Configuration
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REDIRECT_URI="http://localhost:8000/api/integrations/google_calendar/callback"
GOOGLE_CALENDAR_WEBHOOK_SECRET=""



